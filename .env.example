# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.
# Both the API (apps/api) and the web app (apps/web) read this single file.

# ---- Shared ---------------------------------------------------------------
# development | test | production. Seeding is refused in production.
APP_ENV=development

# ---- API (apps/api) -------------------------------------------------------
# PostgreSQL connection string (psycopg 3 driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://freelancer:freelancer@localhost:5432/freelancer_os
# Redis for cache, rate limits and queue coordination.
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the API. Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Used for signing/encryption in later phases. REQUIRED (>=32 random chars) in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
LOG_LEVEL=INFO

# ---- Authentication & sessions (API) --------------------------------------
# Public URL of the web app; used to build password-reset links.
WEB_BASE_URL=http://localhost:3000
# Leave unset: cookies are Secure in production only (browsers drop Secure cookies on plain http).
# COOKIE_SECURE=
# Idle timeout (minutes) and absolute lifetime (days) of a login session.
SESSION_IDLE_TIMEOUT_MINUTES=10080
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
# How many reverse proxies sit in front of the API and append to X-Forwarded-For (0 = none).
# Needed for accurate per-IP rate limits when deployed behind a load balancer.
TRUSTED_PROXY_COUNT=0
# memory (dev/test only) | redis (required in production). Default: memory in dev, redis in production.
# RATE_LIMIT_BACKEND=
# console (dev only: prints reset links to the API log) | disabled (password reset unavailable).
# Default: console in dev, disabled in production until a mail provider is implemented.
# MAIL_BACKEND=

# ---- Credential store (API) -------------------------------------------------
# Encrypts OAuth tokens/API keys at rest. Format "id:key[,id:key...]"; the FIRST key encrypts new secrets,
# the rest stay readable (rotation). REQUIRED in production. Dev/test fall back to an ephemeral key
# (stored credentials are lost on restart). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=

# ---- AI provider (API) ------------------------------------------------------
# mock = rule-based stand-in whose output is labelled "Demo AI" (default in development/test; refused in production)
# gateway = an OpenAI-compatible chat-completions endpoint | disabled = AI features report "not set up" (default in production)
# Keep the key server-side only: never in a NEXT_PUBLIC_* variable, the web app's environment or a committed file.
# AI_PROVIDER=
# AI_BASE_URL=https://your-gateway.example/v1
# AI_API_KEY=
# AI_MODEL=
# Optional cheaper/faster model for classification, extraction and summaries.
# AI_MODEL_FAST=
# Per-attempt timeout, tries per call (first included), total time budget, and calls per workspace per minute.
# AI_TIMEOUT_SECONDS=20
# AI_MAX_ATTEMPTS=2
# AI_TOTAL_BUDGET_SECONDS=45
# AI_RATE_LIMIT_PER_MINUTE=30
# Optional price list (millionths of a currency unit per 1,000 tokens) used only to ESTIMATE cost.
# AI_INPUT_COST_MICROS_PER_1K=
# AI_OUTPUT_COST_MICROS_PER_1K=

# ---- Web (apps/web) -------------------------------------------------------
# URL of the API as reached from the Next.js *server*. Not exposed to the browser.
API_URL=http://localhost:8000
# Display name of the product (working name; configurable).
NEXT_PUBLIC_APP_NAME=Freelancer OS

# ---- Docker Compose (postgres/redis containers) ---------------------------
POSTGRES_USER=freelancer
POSTGRES_PASSWORD=freelancer
POSTGRES_DB=freelancer_os
