# Copy to `.env` (git-ignored) and adjust. Never commit real secrets.
# Both the API (apps/api) and the web app (apps/web) read this single file.

# ---- Shared ---------------------------------------------------------------
# development | test | production. Seeding is refused in production.
APP_ENV=development

# ---- API (apps/api) -------------------------------------------------------
# PostgreSQL connection string (psycopg 3 driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://freelancer:freelancer@localhost:5432/freelancer_os
# Redis for cache, rate limits and queue coordination.
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the API. Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Used for signing/encryption in later phases. REQUIRED (>=32 random chars) in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
LOG_LEVEL=INFO

# ---- Web (apps/web) -------------------------------------------------------
# URL of the API as reached from the Next.js *server*. Not exposed to the browser.
API_URL=http://localhost:8000
# Display name of the product (working name; configurable).
NEXT_PUBLIC_APP_NAME=Freelancer OS

# ---- Docker Compose (postgres/redis containers) ---------------------------
POSTGRES_USER=freelancer
POSTGRES_PASSWORD=freelancer
POSTGRES_DB=freelancer_os
